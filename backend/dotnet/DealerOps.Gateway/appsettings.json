{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "dealerops": {
    "internalHeaderName": "X-Dealer-Internal",
    "internalToken": "dealer-internal",
    "jwt": {
      "mode": "dev",
      "devSecret": "dealer-dev-jwt-secret-change-me"
    },
    "corsAllowedOrigin": "http://localhost:5173"
  },
  "ReverseProxy": {
    "Routes": {
      "dealer-core-photos": {
        "ClusterId": "core",
        "Match": {
          "Path": "/api/v1/vehicles/{vehicleId}/photos/{**catch-all}"
        },
        "Order": 1
      },
      "dealer-core-public": {
        "ClusterId": "core",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        },
        "Order": 10
      },
      "dealer-core-swagger": {
        "ClusterId": "core",
        "Match": {
          "Path": "/swagger/{**catch-all}"
        },
        "Order": 20
      },
      "ai-service-internal": {
        "ClusterId": "ai",
        "Match": {
          "Path": "/internal/v1/{**catch-all}"
        },
        "Order": 5
      }
    },
    "Clusters": {
      "core": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8081"
          }
        },
        "HttpClient": {
          "RequestHeaderEncoding": "utf-8"
        }
      },
      "ai": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8082"
          }
        },
        "HttpClient": {
          "RequestHeaderEncoding": "utf-8"
        }
      }
    }
  }
}
