# Quick start — deploy to Azure in three commands:
#
#   cd deploy/terraform
#   terraform init
#   terraform apply
#
# That's it. All secrets (MySQL password, JWT secret, internal token, admin
# password) are auto-generated. After apply, retrieve the admin password:
#
#   terraform output -raw admin_password
#
# Sign in at the web URL (terraform output web_public_url) as "admin".
#
# To customize, copy this file to terraform.tfvars (git-ignored) and edit:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# ── Region ──────────────────────────────────────────────────────────
# location                = "canadacentral"
# web_app_name            = "dealer-ops-dev"
# mysql_location          = "canadaeast"

# ── Naming ──────────────────────────────────────────────────────────
# prefix      = "dealerops"
# name_suffix = ""        # append when default names are taken

# ── Networking ──────────────────────────────────────────────────────
# cors_allowed_origin   = ""   # empty = this stack's own web app
# operator_ip_addresses = []   # your IP for direct MySQL access

# ── Compute ─────────────────────────────────────────────────────────
# service_plan_sku = "B2"      # B1 = 1.75 GB, B2 = 3.5 GB (recommended)

# ── Secrets (all optional — auto-generated when empty) ──────────────
# mysql_admin_password = ""    # >= 12 chars
# internal_token       = ""    # shared internal header
# jwt_signing_secret   = ""    # >= 32 bytes
# aimanager_api_key    = ""    # LLM key, empty = AI disabled

# ── Platform admin (seeded on first start) ──────────────────────────
# admin_username = "admin"
# admin_password = ""          # auto-generated, retrieve with: terraform output -raw admin_password
# admin_email    = "admin@example.com"
# admin_phone    = ""

# ── AI model ────────────────────────────────────────────────────────
# aimanager_gateway_provider = "groq"
# aimanager_gateway_model    = "qwen/qwen3.8-27b"
