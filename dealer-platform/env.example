# Local development values. Copy to a local .env, or paste them into IDE run
# configurations. Do not commit real values.
#
# There is no container runtime any more: each service is a plain process
# (mvn spring-boot:run / npm run dev) against a MySQL 8 server on 3306.
# Startup order and health checks: ../README.md and ../design/AI-CODING-LOCAL-AND-CLOUD.md.
# Cloud values are not here. The Azure stack sets its own app settings from
# ../deploy/terraform and reads secrets from Key Vault (../deploy/README.md).

# --- Frontend ---
# The only API origin the browser may call. Vite reads this at build and dev time.
VITE_GATEWAY_URL=http://localhost:8080
# Non-Vite alias. Empty = use VITE_GATEWAY_URL.
# Runtime override without a rebuild: dealer-web/public/config.json { "gatewayUrl": ... }.
GATEWAY_PUBLIC_URL=

# --- Gateway ---
GATEWAY_PORT=8080
CORE_URL=http://localhost:8081
AI_URL=http://localhost:8082
# Local Vite origin. Azure sets this to the Static Web Apps origin.
CORS_ALLOWED_ORIGIN=http://localhost:5173
WEB_PUBLIC_ORIGIN=

# --- Core ---
CORE_PORT=8081
# Loopback only, so a classmate on the LAN cannot reach core directly
# (design/AI-CODING-LOCAL-AND-CLOUD.md §5.3). Azure must leave this unset.
SERVER_ADDRESS=127.0.0.1
# Local MySQL 8 on 3306 with database dealer_core. Flyway creates the schema on startup.
MYSQL_URL=jdbc:mysql://localhost:3306/dealer_core?useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=dealer
# Cloud Key Vault secret name: MYSQL-PASSWORD (core only). Local sample is not for Azure.
MYSQL_PASSWORD=dealer_dev_only
# Shared hosted MySQL instead of a local server (design/15 §11 "Shared development database").
# Same engine, same Flyway history, only these three values change. TLS is required, so drop
# useSSL=false/allowPublicKeyRetrieval and use sslMode=REQUIRED:
#   MYSQL_URL=jdbc:mysql://<host>:3306/dealer_core?sslMode=REQUIRED&serverTimezone=UTC
# Real host and credentials do not go in Git.

# --- AI ---
AI_PORT=8082
# Loopback only, same rule as core. SERVER_ADDRESS is per process, so set it in the
# dealer-core and ai-service run configurations and leave it out of dealer-gateway.
# Cloud Key Vault secret name: AIMANAGER-API-KEY (ai-service only; empty here).
# Empty fails the first model call immediately (503 AI_KEY_MISSING) — there is no stub/mock provider.
AIMANAGER_API_KEY=
AIMANAGER_GATEWAY_PROVIDER=groq
AIMANAGER_GATEWAY_MODEL=qwen/qwen3.8-27b
AIMANAGER_GATEWAY_MAX_TOKENS=800

# --- Internal (gateway / core outbound / ai-service). Do not put a real secret in git. ---
# Cloud Key Vault secret name: INTERNAL-TOKEN (value is not in this repo).
INTERNAL_TOKEN=dealer-internal
# Local classroom only, for dealer-gateway and ai-service. Set the same value in all three.
# Do not set this on Azure. Any other Spring profile must use a non-default INTERNAL_TOKEN
# shared by gateway, ai-service, and dealer-core.
SPRING_PROFILES_ACTIVE=dev

# --- JWT (dealer-core issues and validates its own tokens; injected into dealer-gateway too). ---
# Admin-issued username/password auth: ../design/15-Data-Auth-and-Gateway.md §8.
# App Role values in the access token roles[] claim must be exactly:
#   Platform.Admin | Dealer.User
JWT_MODE=dev
DEV_JWT_SECRET=dealer-dev-jwt-secret-change-me
# Seeds the one platform admin account on dealer-core startup (no-op once it exists). Do not commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
