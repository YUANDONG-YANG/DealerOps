# Copy to a local .env. Do not commit real values.

# --- Frontend ---
# Local SPA API origin. Public demo: Cloudflare quick-tunnel gateway origin (deploy/README.md). No tunnel hostname in git.
# Azure backup VM uses the hostname recorded in deploy/README.md. Bicep output gatewayPublicUrl is the undeployed course draft.
VITE_GATEWAY_URL=http://localhost:8080
# Non-Vite alias for pipelines / compose. Empty = use VITE_GATEWAY_URL.
# Compose dealer-web entrypoint writes dist/config.json { "gatewayUrl": GATEWAY_PUBLIC_URL or VITE_GATEWAY_URL }.
# Host Vite (no container): set public/config.json gatewayUrl yourself, or use this VITE_GATEWAY_URL.
GATEWAY_PUBLIC_URL=

# --- Gateway ---
GATEWAY_PORT=8080
CORE_URL=http://host.docker.internal:8081
AI_URL=http://host.docker.internal:8082
# Local Vite origin. Public demo: Cloudflare quick-tunnel web origin (deploy/README.md).
# Azure backup VM uses the hostname recorded in deploy/README.md.
CORS_ALLOWED_ORIGIN=http://localhost:5173
WEB_PUBLIC_ORIGIN=

# --- Core ---
CORE_PORT=8081
MYSQL_URL=jdbc:mysql://localhost:3306/dealer_core?useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=dealer
# Cloud Key Vault secret name: MYSQL-PASSWORD (core only). Local sample is not for Azure.
MYSQL_PASSWORD=dealer_dev_only

# --- AI ---
AI_PORT=8082
# Cloud Key Vault secret name: AIMANAGER-API-KEY (ai-service only; empty here).
AIMANAGER_API_KEY=
AIMANAGER_GATEWAY_PROVIDER=openai
AIMANAGER_GATEWAY_MODEL=
# Compose image default is CI stub. Optional real JAR: AI_MAVEN_ARGS=-DskipTests
AI_MAVEN_ARGS=

# --- Internal (gateway / core outbound / ai-service). Do not put a real secret in git. ---
# Cloud Key Vault secret name: INTERNAL-TOKEN (value is not in this repo).
INTERNAL_TOKEN=dealer-internal
# Local classroom only, for dealer-gateway and ai-service. Compose sets the same value.
# Do not set this on Azure. Any other Spring profile must use a non-default INTERNAL_TOKEN
# shared by gateway, ai-service, and dealer-core.
SPRING_PROFILES_ACTIVE=dev

# --- JWT (dealer-core issues and validates its own tokens; injected into dealer-gateway too). ---
# Admin-issued username/password auth, no Entra: ../design/15-Data-Auth-and-Gateway.md §8.
# App Role values in the access token roles[] claim must be exactly:
#   Platform.Admin | Dealer.User
JWT_MODE=dev
DEV_JWT_SECRET=dealer-dev-jwt-secret-change-me
# Seeds the one platform admin account on dealer-core startup (no-op once it exists). Do not commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
