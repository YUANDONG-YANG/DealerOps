# Copy to a local .env. Do not commit real values.

# --- Frontend ---
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=api://dealer-api/access_as_user
# Local SPA API origin. Azure: public Gateway HTTPS (Bicep output gatewayPublicUrl). No personal hostname in git.
VITE_GATEWAY_URL=http://localhost:8080
# Non-Vite alias for pipelines / compose. Empty = use VITE_GATEWAY_URL.
# Compose/Azure dealer-web entrypoint writes dist/config.json { "gatewayUrl": GATEWAY_PUBLIC_URL or VITE_GATEWAY_URL }.
# Host Vite (no container): set public/config.json gatewayUrl yourself, or use this VITE_GATEWAY_URL.
GATEWAY_PUBLIC_URL=

# --- Gateway ---
GATEWAY_PORT=8080
CORE_URL=http://host.docker.internal:8081
AI_URL=http://host.docker.internal:8082
# Local Vite. Azure: web HTTPS origin (Bicep output webPublicOrigin), not localhost-only.
CORS_ALLOWED_ORIGIN=http://localhost:5173
WEB_PUBLIC_ORIGIN=

# --- Core ---
CORE_PORT=8081
MYSQL_URL=jdbc:mysql://localhost:3306/dealer_core?useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=dealer
# Cloud Key Vault secret name: MYSQL-PASSWORD (core only). Local sample is not for Azure.
MYSQL_PASSWORD=dealer_dev_only

# --- AI ---
AI_PORT=8082
# Cloud Key Vault secret name: AIMANAGER-API-KEY (ai-service only; empty here).
AIMANAGER_API_KEY=
AIMANAGER_GATEWAY_PROVIDER=openai
AIMANAGER_GATEWAY_MODEL=
# Compose image default is CI stub. Optional real JAR: AI_MAVEN_ARGS=-DskipTests
AI_MAVEN_ARGS=

# --- Internal (gateway / core outbound / ai-service). Do not put a real secret in git. ---
# Cloud Key Vault secret name: INTERNAL-TOKEN (value is not in this repo).
INTERNAL_TOKEN=dealer-internal

# --- Entra / JWT (injected into dealer-gateway and dealer-core by compose). ---
# Placeholders compile and start without a real tenant.
# JWT_MODE=dev: local HS256 using DEV_JWT_SECRET (classroom / ITs).
# JWT_MODE=entra: validate iss + aud + JWKS from ENTRA_ISSUER (or ENTRA_JWKS_URI).
JWT_MODE=dev
DEV_JWT_SECRET=dealer-dev-jwt-secret-change-me
ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_AUDIENCE=api://dealer-api
ENTRA_JWKS_URI=
