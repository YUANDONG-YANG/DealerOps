# Maven / Java build output
**/target/

# .NET build output
**/bin/
**/obj/

# Node / frontend build output
**/node_modules/
**/dist/

# Local secrets (keep *.example)
.env
.env.local
.env.*.local
*.pem
*.p12
*.jks

# OS / editor junk
.DS_Store
Thumbs.db
*.log
.idea/
*.iml

# Local MCP config (may contain tokens). The shared .cursor/mcp.json reads tokens from the environment and is committed.
.vscode/mcp.json
.claude/settings.local.json

# Personal/working files that must not be published (incident: accidentally committed/pushed 2026-10-05, see deploy/README.md discussion)
/review/industry-contracts-*/
/screen/

# Terraform working files (deploy/terraform). The provider lock file is committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# Saved plans embed secret values in plain form.
tfplan
*.tfplan
crash.log
crash.*.log

# Local AI provider keys never enter Git; supply AIMANAGER_API_KEY through the environment.
backend/java/ai-service/src/main/resources/api-key.md
backend/java/ai-service/src/main/resources/ai-key.md

# SkyWalking Java agent binary (fetched by deploy/skywalking/download-agent.sh, local dev only)
deploy/skywalking/agent/

# Service log files (log-sum/log.md is tracked)
log-sum/*.log
